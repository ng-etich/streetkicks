<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Order Details | STREETKICKS</title>

    <link rel="stylesheet"
          href="/css/style.css">

    <link rel="stylesheet"
          href="/css/responsive.css">

</head>

<body>

<header class="site-header">

    <div class="container header-inner">

        <a href="/" class="logo">
            STREETKICKS
        </a>

        <nav class="main-nav">

            <a href="/">Home</a>
            <a href="/shop">Shop</a>
            <a href="/shop?category=new">New Arrivals</a>
            <a href="/shop?category=collections">Collections</a>
            <a href="/shop?category=deals">Deals</a>

        </nav>

        <div class="header-actions">

            <a href="/shop">⌕</a>
            <a href="/wishlist">♡</a>
            <a href="/cart">🛒</a>

            <button
                id="theme-toggle"
                type="button">
                ☾
            </button>

            <button
                class="menu-toggle"
                type="button">
                ☰
            </button>

        </div>

    </div>

</header>


<main>

<section class="page-hero">

    <div class="container">

        <span class="hero-label">
            STREETKICKS
        </span>

        <h1>
            ORDER DETAILS
        </h1>

        <p>
            View information about your order.
        </p>

    </div>

</section>


<section class="content-section">

<div class="container">

    <div class="account-content">

        <div class="order-header">

            <h2>
                Order #STK-0001
            </h2>

            <span class="order-status">
                Pending
            </span>

        </div>


        <div class="order-details-grid">

            <div class="info-card">

                <h3>
                    Order Information
                </h3>

                <p>
                    <strong>Order Date:</strong>
                    Pending
                </p>

                <p>
                    <strong>Status:</strong>
                    Pending
                </p>

                <p>
                    <strong>Payment:</strong>
                    Pending
                </p>

            </div>


            <div class="info-card">

                <h3>
                    Delivery Information
                </h3>

                <p>
                    Delivery information will appear
                    once an order has been placed.
                </p>

            </div>

        </div>


        <div class="content-block">

            <h2>
                Order Items
            </h2>

            <div class="empty-state">

                <div class="empty-icon">
                    📦
                </div>

                <p>
                    No order items are available.
                </p>

                <a
                    href="/account/orders"
                    class="btn btn-primary">

                    Back to Orders

                </a>

            </div>

        </div>

    </div>

</div>

</section>

</main>


<footer class="site-footer">

    <div class="container">

        <p>
            &copy; 2026 STREETKICKS.
            All rights reserved.
        </p>

    </div>

</footer>


<script src="/js/theme.js"></script>

</body>

</html>