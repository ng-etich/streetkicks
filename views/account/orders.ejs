<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>My Orders | STREETKICKS</title>

    <link rel="stylesheet"
          href="/css/style.css">

    <link rel="stylesheet"
          href="/css/responsive.css">

</head>

<body>

<header class="site-header">

    <div class="container header-inner">

        <a href="/" class="logo">
            STREETKICKS
        </a>

        <nav class="main-nav">

            <a href="/">Home</a>
            <a href="/shop">Shop</a>
            <a href="/shop?category=new">New Arrivals</a>
            <a href="/shop?category=collections">Collections</a>
            <a href="/shop?category=deals">Deals</a>

        </nav>

        <div class="header-actions">

            <a href="/shop">⌕</a>
            <a href="/wishlist">♡</a>
            <a href="/cart">🛒</a>

            <button
                id="theme-toggle"
                type="button">
                ☾
            </button>

            <button
                class="menu-toggle"
                type="button">
                ☰
            </button>

        </div>

    </div>

</header>


<main>

<section class="page-hero">

    <div class="container">

        <span class="hero-label">
            STREETKICKS
        </span>

        <h1>
            MY ORDERS
        </h1>

        <p>
            View your previous orders.
        </p>

    </div>

</section>


<section class="content-section">

<div class="container">

    <div class="account-layout">

        <aside class="account-sidebar">

            <h3>My Account</h3>

            <a href="/account">
                Profile
            </a>

            <a href="/account/orders">
                My Orders
            </a>

            <a href="/wishlist">
                Wishlist
            </a>

            <a href="/cart">
                Shopping Cart
            </a>

        </aside>


        <div class="account-content">

            <h2>Order History</h2>


            <div class="empty-state">

                <div class="empty-icon">
                    📦
                </div>

                <h3>
                    No Orders Yet
                </h3>

                <p>
                    You haven't placed any orders yet.
                </p>

                <a
                    href="/shop"
                    class="btn btn-primary">

                    Start Shopping

                </a>

            </div>

        </div>

    </div>

</div>

</section>

</main>


<footer class="site-footer">

    <div class="container">

        <p>
            &copy; 2026 STREETKICKS.
            All rights reserved.
        </p>

    </div>

</footer>


<script src="/js/theme.js"></script>

</body>

</html>