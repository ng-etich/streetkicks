<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Wishlist | STREETKICKS</title>

    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/responsive.css">
</head>

<body>

<header class="site-header">

    <div class="container header-inner">

        <a href="/" class="logo">STREETKICKS</a>

        <nav class="main-nav">
            <a href="/">Home</a>
            <a href="/shop">Shop</a>
            <a href="/shop?category=new">New Arrivals</a>
            <a href="/shop?category=collections">Collections</a>
            <a href="/shop?category=deals">Deals</a>
        </nav>

        <div class="header-actions">
            <a href="/shop">⌕</a>
            <a href="/wishlist">♡</a>
            <a href="/cart">🛒</a>

            <button id="theme-toggle" type="button">☾</button>

            <button class="menu-toggle" type="button">☰</button>
        </div>

    </div>

</header>

<main>

<section class="page-hero">

    <div class="container">

        <span class="hero-label">STREETKICKS</span>

        <h1>MY WISHLIST</h1>

        <p>
            Save your favourite sneakers for later.
        </p>

    </div>

</section>

<section class="content-section">

<div class="container">

    <div id="wishlist-container">

        <div class="empty-state">

            <div class="empty-icon">♡</div>

            <h2>Your Wishlist is Empty</h2>

            <p>
                You haven't added any sneakers to your wishlist yet.
            </p>

            <a href="/shop" class="btn btn-primary">
                Explore Sneakers
            </a>

        </div>

    </div>

</div>

</section>

</main>

<footer class="site-footer">

    <div class="container">

        <p>&copy; 2026 STREETKICKS. All rights reserved.</p>

    </div>

</footer>

<script src="/js/theme.js"></script>
<script src="/js/main.js"></script>

</body>
</html>