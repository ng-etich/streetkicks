<section class="newsletter-section">

    <div class="container newsletter-container">

        <div class="newsletter-content">

            <span class="section-label">
                STAY IN THE LOOP
            </span>

            <h2 data-i18n="newsletterTitle">
                Never Miss a Drop.
            </h2>

            <p data-i18n="newsletterText">
                Get the latest sneaker drops, exclusive deals and
                streetwear news straight to your inbox.
            </p>

        </div>

        <form class="newsletter-form">

            <input
                type="email"
                placeholder="Enter your email address"
                data-i18n-placeholder="emailPlaceholder"
                required
            >

            <button type="submit" class="btn btn-primary">
                <span data-i18n="subscribe">
                    Subscribe
                </span>
            </button>

        </form>

    </div>

</section>