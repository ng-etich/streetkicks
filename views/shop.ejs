<%- include("partials/head") %>

<%- include("partials/navbar") %>

<%- include("partials/mobile-menu") %>


<main class="shop-page">


    <!-- =====================================
         SHOP HEADER
    ====================================== -->

    <section class="shop-header">

        <div class="container">

            <span class="section-label">
                STREETKICKS COLLECTION
            </span>

            <h1 data-i18n="shop">
                SHOP
            </h1>

            <p>
                Discover sneakers made for
                every street, every move and
                every style.
            </p>

        </div>

    </section>



    <!-- =====================================
         SHOP CONTENT
    ====================================== -->

    <section class="shop-section">

        <div class="container shop-layout">


            <!-- =================================
                 FILTER SIDEBAR
            ================================== -->

            <aside class="shop-sidebar">

                <div class="filter-header">

                    <h3>
                        FILTER
                    </h3>

                </div>


                <!-- =================================
                     CATEGORY FILTER
                ================================== -->

                <div class="filter-group">

                    <h4>
                        CATEGORY
                    </h4>

                    <div class="filter-options">


                        <!-- ALL -->

                        <a
                            href="/shop?category=all"
                            class="<%= category === 'all' ? 'active' : '' %>"
                        >
                            All Sneakers
                        </a>


                        <!-- MEN -->

                        <a
                            href="/shop?category=men"
                            class="<%= category === 'men' ? 'active' : '' %>"
                        >
                            Men
                        </a>


                        <!-- WOMEN -->

                        <a
                            href="/shop?category=women"
                            class="<%= category === 'women' ? 'active' : '' %>"
                        >
                            Women
                        </a>


                        <!-- KIDS -->

                        <a
                            href="/shop?category=kids"
                            class="<%= category === 'kids' ? 'active' : '' %>"
                        >
                            Kids
                        </a>


                        <!-- UNISEX -->

                        <a
                            href="/shop?category=unisex"
                            class="<%= category === 'unisex' ? 'active' : '' %>"
                        >
                            Unisex
                        </a>


                        <!-- LIMITED -->

                        <a
                            href="/shop?category=limited"
                            class="<%= category === 'limited' ? 'active' : '' %>"
                        >
                            Limited
                        </a>

                    </div>

                </div>



                <!-- =================================
                     SEARCH
                ================================== -->

                <div class="filter-group">

                    <h4>
                        SEARCH
                    </h4>

                    <form
                        action="/shop"
                        method="GET"
                        class="shop-search"
                    >

                        <!-- Keep selected category when searching -->

                        <% if (category && category !== "all") { %>

                            <input
                                type="hidden"
                                name="category"
                                value="<%= category %>"
                            >

                        <% } %>


                        <input
                            type="search"
                            name="search"
                            value="<%= search %>"
                            placeholder="Search sneakers..."
                            autocomplete="off"
                        >


                        <button
                            type="submit"
                            aria-label="Search"
                        >

                            <i data-lucide="search"></i>

                        </button>

                    </form>

                </div>



                <!-- =================================
                     CLEAR FILTERS
                ================================== -->

                <a
                    href="/shop"
                    class="clear-filters"
                >
                    CLEAR FILTERS
                </a>

            </aside>



            <!-- =================================
                 PRODUCTS AREA
            ================================== -->

            <div class="shop-products">


                <!-- =================================
                     PRODUCTS HEADER
                ================================== -->

                <div class="shop-products-header">

                    <div>

                        <span class="product-count">

                            <%= products.length %>

                            <span>
                                <%= products.length === 1 ? "product" : "products" %>
                            </span>

                        </span>


                        <!-- Current category -->

                        <% if (category && category !== "all") { %>

                            <span class="current-filter">

                                <% if (category === "limited") { %>

                                    Limited Edition

                                <% } else { %>

                                    <%= category.charAt(0).toUpperCase() + category.slice(1) %>

                                <% } %>

                            </span>

                        <% } %>


                        <!-- Current search -->

                        <% if (search) { %>

                            <span class="current-filter">

                                Search: "<%= search %>"

                            </span>

                        <% } %>

                    </div>



                    <!-- =================================
                         SORT
                    ================================== -->

                    <div class="sort-container">

                        <label for="sort">
                            Sort:
                        </label>

                        <select
                            id="sort"
                            onchange="sortProducts(this.value)"
                        >

                            <option
                                value=""
                                <%= !sort ? "selected" : "" %>
                            >
                                Featured
                            </option>

                            <option
                                value="price-low"
                                <%= sort === "price-low" ? "selected" : "" %>
                            >
                                Price: Low to High
                            </option>

                            <option
                                value="price-high"
                                <%= sort === "price-high" ? "selected" : "" %>
                            >
                                Price: High to Low
                            </option>

                            <option
                                value="name"
                                <%= sort === "name" ? "selected" : "" %>
                            >
                                Name
                            </option>

                        </select>

                    </div>

                </div>



                <!-- =================================
                     PRODUCT GRID
                ================================== -->

                <% if (products && products.length > 0) { %>


                    <div class="product-grid shop-product-grid">

                        <% products.forEach(product => { %>

                            <%- include(
                                "partials/product-card",
                                {
                                    product: product
                                }
                            ) %>

                        <% }) %>

                    </div>


                <% } else { %>


                    <!-- =================================
                         NO PRODUCTS
                    ================================== -->

                    <div class="no-products">

                        <div class="no-products-icon">

                            <i data-lucide="search-x"></i>

                        </div>


                        <h2>
                            No sneakers found
                        </h2>


                        <p>

                            <% if (category && category !== "all") { %>

                                There are currently no
                                sneakers in this category.

                            <% } else if (search) { %>

                                We couldn't find any
                                sneakers matching your search.

                            <% } else { %>

                                Try another search or
                                browse all our sneakers.

                            <% } %>

                        </p>


                        <a
                            href="/shop"
                            class="btn btn-primary"
                        >
                            VIEW ALL SNEAKERS
                        </a>

                    </div>


                <% } %>


            </div>

        </div>

    </section>

</main>



<!-- =========================================
     NEWSLETTER
========================================== -->

<%- include("partials/newsletter") %>



<!-- =========================================
     FOOTER
========================================== -->

<%- include("partials/footer") %>



<!-- =========================================
     JAVASCRIPT
========================================== -->

<script src="/js/main.js"></script>

<script src="/js/theme.js"></script>

<script src="/js/language.js"></script>

<script src="/js/cart.js"></script>

<script src="/js/wishlist.js"></script>

<script src="/js/products.js"></script>



<script>

    /*
     * SORT PRODUCTS
     *
     * Keeps the current category and
     * search query when sorting.
     */

    function sortProducts(value) {

        const url =
            new URL(window.location.href);


        if (value) {

            url.searchParams.set(
                "sort",
                value
            );

        } else {

            url.searchParams.delete(
                "sort"
            );

        }


        window.location.href =
            url.toString();

    }


    /*
     * CREATE LUCIDE ICONS
     */

    if (
        typeof lucide !== "undefined"
    ) {

        lucide.createIcons();

    }

</script>


</body>
</html>