<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        <%= title || "Shop | STREETKICKS" %>
    </title>

    <meta
        name="description"
        content="Shop the latest STREETKICKS sneakers for men, women and kids."
    >

    <link
        rel="stylesheet"
        href="/css/style.css"
    >

    <link
        rel="stylesheet"
        href="/css/responsive.css"
    >

</head>


<body>

    <!-- =====================================================
         HEADER
    ====================================================== -->

    <header class="site-header">

        <div class="container header-inner">


            <!-- LOGO -->

            <a
                href="/"
                class="logo"
            >
                STREETKICKS
            </a>


            <!-- NAVIGATION -->

            <nav class="main-nav">

                <a href="/">
                    Home
                </a>

                <a
                    href="/shop"
                    class="active"
                >
                    Shop
                </a>

                <a href="/shop?category=new">
                    New Arrivals
                </a>

                <a href="/shop?category=collections">
                    Collections
                </a>

                <a href="/shop?category=deals">
                    Deals
                </a>

            </nav>


            <!-- HEADER ACTIONS -->

            <div class="header-actions">

                <a
                    href="/shop"
                    aria-label="Search"
                    title="Search"
                >
                    🔍
                </a>

                <a
                    href="/wishlist"
                    aria-label="Wishlist"
                    title="Wishlist"
                >
                    ♡
                </a>

                <a
                    href="/account"
                    aria-label="Account"
                    title="My Account"
                >
                    👤
                </a>

                <a
                    href="/cart"
                    aria-label="Shopping Cart"
                    title="Shopping Cart"
                >
                    🛒
                </a>

                <button
                    type="button"
                    id="theme-toggle"
                    aria-label="Toggle dark mode"
                    title="Toggle dark mode"
                >
                    🌙
                </button>

            </div>


        </div>

    </header>



    <!-- =====================================================
         SHOP HERO
    ====================================================== -->

    <section class="shop-hero">

        <div class="container">

            <div class="shop-hero-content">

                <span class="eyebrow">
                    STREETKICKS COLLECTION
                </span>

                <h1>
                    SHOP OUR<br>
                    SNEAKERS
                </h1>

                <p>
                    Discover sneakers built for every street,
                    every move and every lifestyle.
                </p>

            </div>

        </div>

    </section>



    <!-- =====================================================
         SHOP CONTENT
    ====================================================== -->

    <main class="shop-page">

        <div class="container">


            <!-- =================================================
                 SEARCH AND FILTER BAR
            ================================================== -->

            <section class="shop-toolbar">


                <!-- SEARCH -->

                <form
                    action="/shop"
                    method="GET"
                    class="shop-search"
                >

                    <input
                        type="text"
                        name="search"
                        value="<%= typeof search !== 'undefined' ? search : '' %>"
                        placeholder="Search sneakers..."
                        aria-label="Search sneakers"
                    >

                    <% if (typeof category !== 'undefined' && category && category !== 'all') { %>

                        <input
                            type="hidden"
                            name="category"
                            value="<%= category %>"
                        >

                    <% } %>

                    <button
                        type="submit"
                        aria-label="Search"
                    >
                        SEARCH
                    </button>

                </form>



                <!-- SORT -->

                <form
                    action="/shop"
                    method="GET"
                    class="shop-sort"
                >

                    <% if (typeof search !== 'undefined' && search) { %>

                        <input
                            type="hidden"
                            name="search"
                            value="<%= search %>"
                        >

                    <% } %>


                    <% if (typeof category !== 'undefined' && category && category !== 'all') { %>

                        <input
                            type="hidden"
                            name="category"
                            value="<%= category %>"
                        >

                    <% } %>


                    <label for="sort">
                        SORT BY
                    </label>

                    <select
                        id="sort"
                        name="sort"
                        onchange="this.form.submit()"
                    >

                        <option
                            value=""
                            <%= !sort ? "selected" : "" %>
                        >
                            Featured
                        </option>

                        <option
                            value="price-low"
                            <%= sort === "price-low" ? "selected" : "" %>
                        >
                            Price: Low to High
                        </option>

                        <option
                            value="price-high"
                            <%= sort === "price-high" ? "selected" : "" %>
                        >
                            Price: High to Low
                        </option>

                    </select>

                </form>


            </section>



            <!-- =================================================
                 CATEGORY NAVIGATION
            ================================================== -->

            <section class="shop-categories">

                <div class="category-heading">

                    <span>
                        SHOP BY CATEGORY
                    </span>

                </div>


                <div class="category-links">

                    <a
                        href="/shop"
                        class="<%= !category || category === 'all' ? 'active' : '' %>"
                    >
                        ALL
                    </a>


                    <a
                        href="/shop?category=Men"
                        class="<%= category === 'Men' ? 'active' : '' %>"
                    >
                        MEN
                    </a>


                    <a
                        href="/shop?category=Women"
                        class="<%= category === 'Women' ? 'active' : '' %>"
                    >
                        WOMEN
                    </a>


                    <a
                        href="/shop?category=Kids"
                        class="<%= category === 'Kids' ? 'active' : '' %>"
                    >
                        KIDS
                    </a>


                    <a
                        href="/shop?category=limited"
                        class="<%= category === 'limited' ? 'active' : '' %>"
                    >
                        LIMITED
                    </a>


                    <a
                        href="/shop?category=new"
                        class="<%= category === 'new' ? 'active' : '' %>"
                    >
                        NEW ARRIVALS
                    </a>


                    <a
                        href="/shop?category=deals"
                        class="<%= category === 'deals' ? 'active' : '' %>"
                    >
                        DEALS
                    </a>

                </div>

            </section>



            <!-- =================================================
                 RESULTS HEADER
            ================================================== -->

            <section class="products-heading">

                <div>

                    <span class="eyebrow">
                        STREETKICKS
                    </span>

                    <h2>

                        <% if (category && category !== "all") { %>

                            <%= category %> SNEAKERS

                        <% } else if (search) { %>

                            SEARCH RESULTS

                        <% } else { %>

                            ALL SNEAKERS

                        <% } %>

                    </h2>

                </div>


                <div class="results-count">

                    <%= products ? products.length : 0 %>
                    PRODUCTS

                </div>

            </section>



            <!-- =================================================
                 SEARCH RESULT MESSAGE
            ================================================== -->

            <% if (search) { %>

                <div class="search-message">

                    <p>

                        Showing results for:
                        <strong>
                            "<%= search %>"
                        </strong>

                    </p>

                    <a href="/shop">
                        Clear Search
                    </a>

                </div>

            <% } %>



            <!-- =================================================
                 PRODUCTS
            ================================================== -->

            <% if (products && products.length > 0) { %>


                <section class="products-grid">


                    <% products.forEach(product => { %>

                        <article class="product-card">


                            <!-- PRODUCT IMAGE -->

                            <div class="product-image-container">


                                <% if (product.badge) { %>

                                    <span class="product-badge">

                                        <%= product.badge %>

                                    </span>

                                <% } %>


                                <a
                                    href="/products/<%= product.id %>"
                                    class="product-image-link"
                                >

                                    <img
                                        src="<%= product.image %>"
                                        alt="<%= product.name %>"
                                        class="product-image"
                                        loading="lazy"
                                    >

                                </a>


                                <!-- QUICK ACTION -->

                                <button
                                    type="button"
                                    class="wishlist-button"
                                    data-product-id="<%= product.id %>"
                                    aria-label="Add <%= product.name %> to wishlist"
                                    title="Add to wishlist"
                                >
                                    ♡
                                </button>


                            </div>



                            <!-- PRODUCT INFORMATION -->

                            <div class="product-info">


                                <div class="product-category">

                                    <%= product.category %>

                                </div>


                                <h3 class="product-name">

                                    <a
                                        href="/products/<%= product.id %>"
                                    >

                                        <%= product.name %>

                                    </a>

                                </h3>



                                <!-- REVIEWS -->

                                <div class="product-rating">

                                    <span class="stars">
                                        ★★★★★
                                    </span>

                                    <span class="review-count">

                                        (<%= product.reviews || 0 %>)

                                    </span>

                                </div>



                                <!-- PRICE -->

                                <div class="product-price">


                                    <span class="current-price">

                                        KSh
                                        <%= Number(product.price).toLocaleString() %>

                                    </span>


                                    <% if (product.oldPrice) { %>

                                        <span class="old-price">

                                            KSh
                                            <%= Number(product.oldPrice).toLocaleString() %>

                                        </span>

                                    <% } %>


                                </div>



                                <!-- SIZES -->

                                <% if (product.sizes && product.sizes.length > 0) { %>

                                    <div class="product-sizes">

                                        <span>
                                            Sizes:
                                        </span>

                                        <% product.sizes.slice(0, 5).forEach(size => { %>

                                            <span class="size">
                                                <%= size %>
                                            </span>

                                        <% }) %>

                                    </div>

                                <% } %>



                                <!-- VIEW PRODUCT -->

                                <a
                                    href="/products/<%= product.id %>"
                                    class="product-button"
                                >
                                    VIEW PRODUCT
                                </a>


                            </div>


                        </article>

                    <% }) %>


                </section>


            <% } else { %>


                <!-- =================================================
                     NO PRODUCTS
                ================================================== -->

                <section class="no-products">

                    <div class="no-products-icon">
                        👟
                    </div>

                    <h2>
                        NO SNEAKERS FOUND
                    </h2>

                    <p>
                        We couldn't find any sneakers matching
                        your search or selected category.
                    </p>

                    <a
                        href="/shop"
                        class="product-button"
                    >
                        VIEW ALL SNEAKERS
                    </a>

                </section>


            <% } %>


        </div>

    </main>



    <!-- =====================================================
         NEWSLETTER
    ====================================================== -->

    <section class="newsletter-section">

        <div class="container">

            <div class="newsletter-content">


                <div>

                    <span class="eyebrow">
                        STAY IN THE LOOP
                    </span>

                    <h2>
                        GET THE LATEST KICKS
                    </h2>

                    <p>
                        Sign up for new arrivals,
                        exclusive releases and special offers.
                    </p>

                </div>


                <form
                    action="#"
                    method="POST"
                    class="newsletter-form"
                    onsubmit="return false;"
                >

                    <input
                        type="email"
                        placeholder="Enter your email address"
                        aria-label="Email address"
                        required
                    >

                    <button type="submit">
                        SUBSCRIBE
                    </button>

                </form>


            </div>

        </div>

    </section>



    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="site-footer">

        <div class="container">

            <div class="footer-grid">


                <!-- =================================================
                     BRAND
                ================================================== -->

                <div class="footer-brand">


                    <a
                        href="/"
                        class="logo"
                    >
                        STREETKICKS
                    </a>


                    <p>
                        Step into your style.
                        Premium sneakers for every street,
                        every move and every lifestyle.
                    </p>


                    <div class="social-links">

                        <a
                            href="javascript:void(0);"
                            aria-label="Instagram"
                            title="Instagram"
                        >
                            IG
                        </a>

                        <a
                            href="javascript:void(0);"
                            aria-label="Facebook"
                            title="Facebook"
                        >
                            FB
                        </a>

                        <a
                            href="javascript:void(0);"
                            aria-label="TikTok"
                            title="TikTok"
                        >
                            TK
                        </a>

                    </div>


                </div>



                <!-- =================================================
                     SHOP
                ================================================== -->

                <div class="footer-column">

                    <h3>
                        SHOP
                    </h3>

                    <ul>

                        <li>
                            <a href="/shop">
                                All Sneakers
                            </a>
                        </li>

                        <li>
                            <a href="/shop?category=Men">
                                Men
                            </a>
                        </li>

                        <li>
                            <a href="/shop?category=Women">
                                Women
                            </a>
                        </li>

                        <li>
                            <a href="/shop?category=Kids">
                                Kids
                            </a>
                        </li>

                        <li>
                            <a href="/shop?category=new">
                                New Arrivals
                            </a>
                        </li>

                        <li>
                            <a href="/shop?category=deals">
                                Deals
                            </a>
                        </li>

                        <li>
                            <a href="/shop?category=limited">
                                Limited
                            </a>
                        </li>

                    </ul>

                </div>



                <!-- =================================================
                     INFORMATION
                ================================================== -->

                <div class="footer-column">

                    <h3>
                        INFORMATION
                    </h3>

                    <ul>

                        <li>
                            <a href="/about">
                                About Us
                            </a>
                        </li>

                        <li>
                            <a href="/contact">
                                Contact Us
                            </a>
                        </li>

                        <li>
                            <a href="/delivery">
                                Delivery Information
                            </a>
                        </li>

                        <li>
                            <a href="/returns">
                                Returns & Exchange
                            </a>
                        </li>

                        <li>
                            <a href="/size-guide">
                                Size Guide
                            </a>
                        </li>

                        <li>
                            <a href="/faq">
                                FAQs
                            </a>
                        </li>

                    </ul>

                </div>



                <!-- =================================================
                     ACCOUNT
                ================================================== -->

                <div class="footer-column">

                    <h3>
                        ACCOUNT
                    </h3>

                    <ul>

                        <li>
                            <a href="/account">
                                My Account
                            </a>
                        </li>

                        <li>
                            <a href="/account/orders">
                                My Orders
                            </a>
                        </li>

                        <li>
                            <a href="/wishlist">
                                Wishlist
                            </a>
                        </li>

                        <li>
                            <a href="/cart">
                                Shopping Cart
                            </a>
                        </li>

                        <li>
                            <a href="/checkout">
                                Checkout
                            </a>
                        </li>

                    </ul>

                </div>


            </div>



            <!-- =================================================
                 FOOTER BOTTOM
            ================================================== -->

            <div class="footer-bottom">

                <p>
                    &copy; <%= new Date().getFullYear() %>
                    STREETKICKS.
                    All Rights Reserved.
                </p>


                <div class="footer-bottom-links">

                    <a href="/faq">
                        FAQs
                    </a>

                    <a href="/delivery">
                        Delivery
                    </a>

                    <a href="/returns">
                        Returns
                    </a>

                    <a href="/contact">
                        Contact
                    </a>

                </div>

            </div>


        </div>

    </footer>



    <!-- =====================================================
         JAVASCRIPT
    ====================================================== -->

    <script src="/js/theme.js"></script>

    <script src="/js/main.js"></script>

    <script src="/js/products.js"></script>

    <script src="/js/cart.js"></script>


</body>

</html>